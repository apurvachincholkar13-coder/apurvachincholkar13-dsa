#include <iostream>
using namespace std;

struct Node
{
    int coeff;
    int power;
    Node *next;
};

Node* createNode(int coeff, int power)
{
    Node *newNode = new Node;

    newNode->coeff = coeff;
    newNode->power = power;
    newNode->next = NULL;

    return newNode;
}

void insert(Node* &head, int coeff, int power)
{
    Node *newNode = createNode(coeff, power);

    if(head == NULL)
    {
        head = newNode;
        return;
    }

    Node *temp = head;
    Node *prev = NULL;

    while(temp != NULL && temp->power > power)
    {
        prev = temp;
        temp = temp->next;
    }

    if(temp != NULL && temp->power == power)
    {
        temp->coeff = temp->coeff + coeff;
        delete newNode;
        return;
    }

    if(prev == NULL)
    {
        newNode->next = head;
        head = newNode;
    }
    else
    {
        newNode->next = temp;
        prev->next = newNode;
    }
}

void display(Node *head)
{
    Node *temp = head;

    if(head == NULL)
    {
        cout << "0";
        return;
    }

    while(temp != NULL)
    {
        if(temp->coeff > 0 && temp != head)
            cout << " + ";

        if(temp->coeff < 0)
            cout << " - ";

        int c = temp->coeff;

        if(c < 0)
            c = -c;

        if(temp->power == 0)
        {
            cout << c;
        }
        else if(temp->power == 1)
        {
            if(c != 1)
                cout << c;

            cout << "x";
        }
        else
        {
            if(c != 1)
                cout << c;

            cout << "x^" << temp->power;
        }

        temp = temp->next;
    }
}

void createPolynomial(Node* &head)
{
    int n;
    int coeff, power;

    cout << "Enter no.of terms: ";
    cin >> n;

    for(int i = 0; i < n; i++)
    {
        cout << "Enter coefficient: ";
        cin >> coeff;

        cout << "Enter power: ";
        cin >> power;

        insert(head, coeff, power);
    }
}

Node* addPolynomial(Node *p1, Node *p2)
{
    Node *result = NULL;

    while(p1 != NULL && p2 != NULL)
    {
        if(p1->power == p2->power)
        {
            insert(result, p1->coeff + p2->coeff, p1->power);

            p1 = p1->next;
            p2 = p2->next;
        }
        else if(p1->power > p2->power)
        {
            insert(result, p1->coeff, p1->power);

            p1 = p1->next;
        }
        else
        {
            insert(result, p2->coeff, p2->power);

            p2 = p2->next;
        }
    }

    while(p1 != NULL)
    {
        insert(result, p1->coeff, p1->power);
        p1 = p1->next;
    }

    while(p2 != NULL)
    {
        insert(result, p2->coeff, p2->power);
        p2 = p2->next;
    }

    return result;
}

Node* subtractPolynomial(Node *p1, Node *p2)
{
    Node *result = NULL;

    while(p1 != NULL && p2 != NULL)
    {
        if(p1->power == p2->power)
        {
            insert(result, p1->coeff - p2->coeff, p1->power);

            p1 = p1->next;
            p2 = p2->next;
        }
        else if(p1->power > p2->power)
        {
            insert(result, p1->coeff, p1->power);

            p1 = p1->next;
        }
        else
        {
            insert(result, -p2->coeff, p2->power);

            p2 = p2->next;
        }
    }

    while(p1 != NULL)
    {
        insert(result, p1->coeff, p1->power);
        p1 = p1->next;
    }

    while(p2 != NULL)
    {
        insert(result, -p2->coeff, p2->power);
        p2 = p2->next;
    }

    return result;
}

Node* multiplyPolynomial(Node *p1, Node *p2)
{
    Node *result = NULL;

    Node *temp1 = p1;

    while(temp1 != NULL)
    {
        Node *temp2 = p2;

        while(temp2 != NULL)
        {
            int coeff = temp1->coeff * temp2->coeff;
            int power = temp1->power + temp2->power;

            insert(result, coeff, power);

            temp2 = temp2->next;
        }

        temp1 = temp1->next;
    }

    return result;
}

int main()
{
    Node *poly1 = NULL;
    Node *poly2 = NULL;
    Node *result = NULL;

    int choice;
    cout << " Polynomial Calculator" << endl;
    cout << " Using Linked List" << endl;
    cout << "-----------------------------------" << endl;


    cout << "\nEnter First Polynomial:" << endl;
    createPolynomial(poly1);

    cout << "\nEnter Second Polynomial:" << endl;
    createPolynomial(poly2);

    cout << "\nFirst Polynomial = ";
    display(poly1);

    cout << "\nSecond Polynomial = ";
    display(poly2);

    cout << "\n\n--------- MENU ---------" << endl;
    cout << "1. Addition" << endl;
    cout << "2. Subtraction" << endl;
    cout << "3. Multiplication" << endl;

    cout << "\nEnter your choice: ";
    cin >> choice;

    if(choice == 1)
    {
        result = addPolynomial(poly1, poly2);

        cout << "\nAddition = ";
        display(result);
    }
    else if(choice == 2)
    {
        result = subtractPolynomial(poly1, poly2);

        cout << "\nSubtraction = ";
        display(result);
    }
    else if(choice == 3)
    {
        result = multiplyPolynomial(poly1, poly2);

        cout << "\nMultiplication = ";
        display(result);
    }
    else
    {
        cout << "\nInvalid choice";
    }

    cout << "\n\nTime Complexity:" << endl;

    if(choice == 1)
    {
        cout << "Addition: O(n + m)";
    }
    else if(choice == 2)
    {
        cout << "Subtraction: O(n + m)";
    }
    else if(choice == 3)
    {
        cout << "Multiplication: O(n * m)";
    }

    cout << endl;

    return 0;
}

#include <iostream>
#include <string>
using namespace std;
struct SNode
{
    string name;
    string phone;
    SNode *next;
};

SNode *sHead = NULL;

void addSingly(string name, string phone)
{
    SNode *newNode = new SNode;

    newNode->name = name;
    newNode->phone = phone;
    newNode->next = sHead;

    sHead = newNode;
}

void deleteSingly(string name)
{
    SNode *temp = sHead;
    SNode *prev = NULL;

    while (temp != NULL)
    {
        if (temp->name == name)
        {
            if (prev == NULL)
                sHead = temp->next;
            else
                prev->next = temp->next;

            delete temp;

            cout << "Contact deleted.\n";
            return;
        }

        prev = temp;
        temp = temp->next;
    }

    cout << "Contact not found.\n";
}

void searchSingly(string name)
{
    SNode *temp = sHead;

    while (temp != NULL)
    {
        if (temp->name == name)
        {
            cout << "Name: " << temp->name << endl;
            cout << "Phone: " << temp->phone << endl;
            return;
        }

        temp = temp->next;
    }

    cout << "Contact not found.\n";
}

void displaySingly()
{
    SNode *temp = sHead;

    if (temp == NULL)
    {
        cout << "No contacts.\n";
        return;
    }

    while (temp != NULL)
    {
        cout << temp->name << " - " << temp->phone << endl;
        temp = temp->next;
    }
}

struct DNode
{
    string name;
    string phone;
    DNode *prev;
    DNode *next;
};

DNode *dHead = NULL;
DNode *dTail = NULL;

void addDoublyBeginning(string name, string phone)
{
    DNode *newNode = new DNode;

    newNode->name = name;
    newNode->phone = phone;
    newNode->prev = NULL;
    newNode->next = dHead;

    if (dHead != NULL)
        dHead->prev = newNode;
    else
        dTail = newNode;

    dHead = newNode;
}

void addDoublyEnd(string name, string phone)
{
    DNode *newNode = new DNode;

    newNode->name = name;
    newNode->phone = phone;
    newNode->next = NULL;
    newNode->prev = dTail;

    if (dTail != NULL)
        dTail->next = newNode;
    else
        dHead = newNode;

    dTail = newNode;
}

void deleteDoublyBeginning()
{
    if (dHead == NULL)
    {
        cout << "No contacts.\n";
        return;
    }

    DNode *temp = dHead;
    dHead = dHead->next;

    if (dHead != NULL)
        dHead->prev = NULL;
    else
        dTail = NULL;

    delete temp;

    cout << "Contact deleted from beginning.\n";
}

void deleteDoublyEnd()
{
    if (dTail == NULL)
    {
        cout << "No contacts.\n";
        return;
    }

    DNode *temp = dTail;
    dTail = dTail->prev;

    if (dTail != NULL)
        dTail->next = NULL;
    else
        dHead = NULL;

    delete temp;

    cout << "Contact deleted from end.\n";
}

struct CNode
{
    string name;
    string phone;
    CNode *next;
};

CNode *cTail = NULL;

void addCircular(string name, string phone)
{
    CNode *newNode = new CNode;

    newNode->name = name;
    newNode->phone = phone;

    if (cTail == NULL)
    {
        cTail = newNode;
        newNode->next = cTail;
    }
    else
    {
        newNode->next = cTail->next;
        cTail->next = newNode;
        cTail = newNode;
    }
}

void displayCircular()
{
    if (cTail == NULL)
    {
        cout << "No contacts.\n";
        return;
    }

    CNode *temp = cTail->next;

    do
    {
        cout << temp->name << " - " << temp->phone << endl;
        temp = temp->next;

    } while (temp != cTail->next);
}

int main()
{
    int choice;
    string name, phone;

    do
    {
        cout << "\n====================================\n";
        cout << "       DIGITAL CONTACT BOOK\n";
        cout << "====================================\n";

        cout << "1. Add Contact\n";
        cout << "2. Delete Contact\n";
        cout << "3. Search Contact\n";
        cout << "4. Display Contacts\n";
        cout << "5. Add/Delete from Both Ends (DLL)\n";
        cout << "6. Exit\n";

        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
            {
                cout << "Enter name: ";
                cin >> name;

                cout << "Enter phone: ";
                cin >> phone;

                addSingly(name, phone);

                cout << "Contact added.\n";

                break;
            }

            case 2:
            {
                cout << "Enter name to delete: ";
                cin >> name;

                deleteSingly(name);

                break;
            }

            case 3:
            {
                cout << "Enter name to search: ";
                cin >> name;

                searchSingly(name);

                break;
            }

            case 4:
            {
                cout << "Singly Linked List:\n";
                displaySingly();

                cout << "\nCircular Linked List:\n";
                displayCircular();

                break;
            }

            case 5:
            {
                int option;

                cout << "\n1. Add at Beginning\n";
                cout << "2. Add at End\n";
                cout << "3. Delete from Beginning\n";
                cout << "4. Delete from End\n";

                cout << "Enter choice: ";
                cin >> option;

                if (option == 1)
                {
                    cout << "Enter name: ";
                    cin >> name;

                    cout << "Enter phone: ";
                    cin >> phone;

                    addDoublyBeginning(name, phone);

                    cout << "Contact added at beginning.\n";
                }
                else if (option == 2)
                {
                    cout << "Enter name: ";
                    cin >> name;

                    cout << "Enter phone: ";
                    cin >> phone;

                    addDoublyEnd(name, phone);

                    cout << "Contact added at end.\n";
                }
                else if (option == 3)
                {
                    deleteDoublyBeginning();
                }
                else if (option == 4)
                {
                    deleteDoublyEnd();
                }
                else
                {
                    cout << "Invalid choice.\n";
                }

                break;
            }

            case 6:
                cout << "Exiting Contact Book...\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 6);

    return 0;
}

#include <iostream>
#include <cstring>
using namespace std;

char stackArr[100];
int top = -1;

// Push operation
void push(char ch)
{
    if (top == 99)
    {
        cout << "Stack Overflow\n";
        return;
    }

    stackArr[++top] = ch;
}

// Pop operation
char pop()
{
    if (top == -1)
    {
        return '\0';
    }

    return stackArr[top--];
}

// Check whether stack is empty
bool isEmpty()
{
    return top == -1;
}

// Return precedence of operator
int precedence(char ch)
{
    if (ch == '^')
        return 3;

    if (ch == '*' || ch == '/')
        return 2;

    if (ch == '+' || ch == '-')
        return 1;

    return 0;
}

// Convert infix to postfix
void infixToPostfix(char infix[], char postfix[])
{
    int i = 0, j = 0;
    char ch;

    while (infix[i] != '\0')
    {
        ch = infix[i];

        // If operand, add directly to postfix
        if (isalnum(ch))
        {
            postfix[j++] = ch;
        }

        // If opening bracket
        else if (ch == '(')
        {
            push(ch);
        }

        // If closing bracket
        else if (ch == ')')
        {
            while (!isEmpty() && stackArr[top] != '(')
            {
                postfix[j++] = pop();
            }

            if (!isEmpty())
                pop();   // Remove '('
        }

        // If operator
        else
        {
            while (!isEmpty() &&
                   precedence(stackArr[top]) >= precedence(ch))
            {
                postfix[j++] = pop();
            }

            push(ch);
        }

        i++;
    }

    // Pop remaining operators
    while (!isEmpty())
    {
        postfix[j++] = pop();
    }

    postfix[j] = '\0';
}

int main()
{
    int maxSize;

    cout << "Enter maximum size of expression: ";
    cin >> maxSize;

    char infix[maxSize];
    char postfix[maxSize];

    cout << "Enter infix expression: ";
    cin >> infix;

    cout << "\nInfix expression: " << infix << endl;

    infixToPostfix(infix, postfix);

    cout << "Postfix expression: " << postfix << endl;

    return 0;
}
